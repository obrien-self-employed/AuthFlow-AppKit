<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AuthFlowApp1</RootNamespace>
    <UserSecretsId>authflowapp1-dev-secrets</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- AuthFlow.AppKit brings AuthFlow.LicenseClient in transitively. -->
    <PackageReference Include="AuthFlow.AppKit" Version="0.1.0" />
    <PackageReference Include="Radzen.Blazor" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
  </ItemGroup>

</Project>
