<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>AuthFlow.Template</PackageId>
    <Version>0.1.1</Version>
    <Authors>Brackford-0brien</Authors>
    <Description>
      dotnet-new template pack: scaffolds a Blazor Server app pre-wired with
      AuthFlow.AppKit (license activation + update checking), Kestrel +
      Windows Service host, an Inno Setup installer, and the generic
      release.yml CI/CD pipeline. Run `dotnet new authflow-blazor -n MyApp`.
    </Description>
    <PackageTags>dotnet-new;templates;authflow</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <RepositoryUrl>https://github.com/Brackford-0brien/AuthFlow-AppKit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" PackagePath="content\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="**\*.cs" />
  </ItemGroup>

</Project>
