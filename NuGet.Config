<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!--
      Local feed for the pilot AuthFlow.LicenseClient SDK package (same
      package/version as used by FneManuelInvoiceApp). The .nupkg is produced
      from Brackford-0brien/AuthFlow, sdk/dotnet/AuthFlow.LicenseClient, via
      `dotnet pack`, and committed here as a local package source so this
      repo restores without needing access to the AuthFlow source repo. Once
      AuthFlow publishes the package to a real feed (nuget.org, GitHub
      Packages, or another private feed), this local source and the
      committed .nupkg should be removed and replaced by that feed's URL.
    -->
    <add key="authflow-local" value="local-nuget-feed" />
  </packageSources>
</configuration>
