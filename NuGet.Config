<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Every AuthFlow package (AuthFlow.LicenseClient, AuthFlow.AppKit,
      AuthFlow.Template) is published on nuget.org: no package file is
      committed to this repository any more.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
